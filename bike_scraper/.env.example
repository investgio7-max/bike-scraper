# =====================
# DATABASE
# =====================
DATABASE_URL=postgresql://user:password@localhost:5432/bike_scraper

# =====================
# SCRAPING
# =====================
SCRAPE_INTERVAL=600              # Интервал в секундах (10 минут)
MAX_RESULTS=100                  # Макс результатов за раз
REQUEST_TIMEOUT=30               # Таймаут запроса

# =====================
# PROXIES (Опционально)
# =====================
USE_PROXIES=False
PROXIES_LIST=http://proxy1:port,http://proxy2:port

# =====================
# IMAGE DOWNLOAD
# =====================
DOWNLOAD_IMAGES=True
IMAGES_DIR=./images
MAX_IMAGE_SIZE_MB=10

# =====================
# LOGGING
# =====================
LOG_LEVEL=INFO
LOG_FILE=./logs/scraper.log

# =====================
# REDIS (для будущих расширений)
# =====================
REDIS_URL=redis://localhost:6379/0

# =====================
# API
# =====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# =====================
# WALLAPOP CONFIG
# =====================
# Минимум и максимум цена в EUR
MIN_PRICE=100
MAX_PRICE=5000

# Страны для поиска
LOCATIONS=Spain

# =====================
# SYSTEM
# =====================
DEBUG=False
HEADLESS_BROWSER=True
